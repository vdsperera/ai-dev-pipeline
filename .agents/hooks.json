{
  "security-commit-gate": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/security-gate.ps1"
          }
        ]
      }
    ]
  }
}
